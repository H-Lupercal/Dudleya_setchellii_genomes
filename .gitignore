*.nto

# Generated/downloaded reference bundles and copied query FASTAs
dudleya_organelle_qc/*_refs.fa
dudleya_organelle_qc/*_cds_*.fa
godsgateVER/references/
godsgateVER/*_refs.fa
godsgateVER/*_cross_refs.fa
