# Intermediate feature-transfer metadata and raw annotation BLAST outputs
godsgateVER/annotation/*_feature_meta.json
godsgateVER/annotation/*_feature_blastn.tsv
godsgateVER/annotation/*_protein_tblastn.tsv

# Raw whole-genome BLAST outputs from Godsgate; keep compact *.summary.tsv files
godsgateVER/*.blastn.tsv

# Intermediate marker/protein alignment outputs from the independent QC pass
dudleya_organelle_qc/*_aa_vs_*.tsv
dudleya_organelle_qc/*_cds_vs_*.tsv

# Keep original input FASTAs
!Dudleya_hifiasm_purged_manual_chloroplast.fa
!Dudleya_hifiasm_purged_manual_mitochondria.fa

# Keep reports
!dudleya_organelle_qc/report.md
!godsgateVER/report.md

# Keep independent QC whole-genome evidence
!dudleya_organelle_qc/chloroplast_vs_cprefs.tsv
!dudleya_organelle_qc/chloroplast_vs_mitorefs.tsv
!dudleya_organelle_qc/mitochondria_vs_cprefs.tsv
!dudleya_organelle_qc/mitochondria_vs_mitorefs.tsv

# Keep Godsgate annotations and summaries
