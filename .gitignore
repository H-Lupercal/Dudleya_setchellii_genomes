# Dudleya organelle alignment pipeline outputs.
# Keep final deliverables and compact provenance visible. Heavy intermediates
# such as BAMs, VCF indexes, BLAST databases, and runtime caches are ignored by
# the global rules above or the explicit directory rules below.
dudleya_organelle_alignment_pipeline/results/**
!dudleya_organelle_alignment_pipeline/results/
!dudleya_organelle_alignment_pipeline/results/**/
