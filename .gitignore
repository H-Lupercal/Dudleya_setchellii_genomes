# Immutable local source data (represented by canonical checksum manifests)
source_data/
*.fastq
*.fastq.gz
*.fq
*.fq.gz

# Canonical regenerable work and heavy intermediates
canonical_publication/work/**
!canonical_publication/work/.gitkeep
canonical_publication/provenance/runs/*/logs/
canonical_publication/results/qc/*/fastp/*.html
canonical_publication/results/qc/*/fastp/*.json
*.sam
*.bam
*.bai
*.cram
*.crai
*.bcf
*.g.vcf.gz
*.fai
*.amb
*.ann
*.bwt
*.pac
*.sa
*.ndb
*.nhr
*.nin
*.njs
*.nog
*.nos
*.not
*.nsq
*.ntf
*.nto
*.tbi
*.csi
*.ckp.gz
*.ufboot

# Canonical final VCFs are deliberate tracked deliverables.
*.vcf
*.vcf.gz
!canonical_publication/results/variants/*.vcf
!canonical_publication/results/variants/*.vcf.gz
!canonical_publication/results/variants/**/*.vcf
!canonical_publication/results/variants/**/*.vcf.gz
!canonical_publication/pipeline/tests/fixtures/*.vcf
!supplementary_analysis/results/**/*.vcf.gz

# The tracked noncanonical snapshot is preserved on the remote archive branch.
# Any complete or partial local checkout remains workstation-only on main.
archive_noncanonical/

# Runtime caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.snakemake/
.superpowers/
.worktrees/
.tools/
**/.matplotlib/

# Supplementary analyses keep only final, provenance-bearing artifacts.
supplementary_analysis/work/**
!supplementary_analysis/work/.gitkeep
supplementary_analysis/.pytest_cache/
supplementary_analysis/provenance/runs/*/logs/
